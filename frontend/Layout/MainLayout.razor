@inherits LayoutComponentBase
@inject RadioStateService RadioState

<div class="app-layout">
    <!-- Barra Superior Principal -->
    <header class="app-topbar">
        <div class="topbar-container">
            <div class="brand-group">
                <a href="" class="brand-link" title="Radio Mundial — Sintonizador Global Hi-Fi">
                    <img src="img/radio-mundial-icono.svg" alt="Radio Mundial — Sintonizador Global Hi-Fi" class="brand-logo-img" />
                    <span class="brand-text">Radio<span class="brand-accent">Mundial</span></span>
                </a>
                <span class="brand-tagline">TRANSISTOR STREAMING</span>
            </div>

            <div class="topbar-status-group">
                <button type="button" class="status-pill topbar-feedback-btn" @onclick="() => RadioState.OpenFeedbackModal()" title="Buzón de sugerencias: propón estaciones de tu ciudad o mejoras">
                    <span class="feedback-pen-icon">✍️</span>
                    <span class="feedback-label">Sugerir Emisora / Falla</span>
                </button>

                <div class="status-pill status-live">
                    <span class="pulse-dot"></span>
                    <span>GLOBAL LIVE</span>
                </div>
                <div class="status-pill status-audio">
                    <span>⚡ CDN HD DIRECT</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Contenido Principal Full-Width -->
    <main class="app-main-content">
        @Body
    </main>

    <!-- Banner de Cookies y Privacidad -->
    <CookieConsent />

    <!-- Barra Inferior de Audio Persistente -->
    <RadioPlayer />

    <!-- Modal Global de Sugerencias y Comentarios -->
    <FeedbackModal />
</div>
