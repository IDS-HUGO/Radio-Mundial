@page "/"
@using frontend.Models
@using frontend.Services
@inject RadioStateService RadioState
@implements IDisposable

<PageTitle>Radio Mundial | Transmisión Directa Global Hi-Fi</PageTitle>

<div class="studio-cockpit-container px-2 px-md-4 py-3">
    @if (IsSideBySide)
    {
        <!-- ==============================================================
             DISPOSICIÓN BENTO COCKPIT: SINTONIZADOR FIJO + CATÁLOGO BENTO
             ============================================================== -->
        <div class="studio-cockpit-row mb-3">
            
            <!-- Columna Izquierda: Sintonizador Neo-Skeuomorphic + Tarjeta Bento de Autor -->
            <div class="studio-left-dock">
                <div class="d-lg-none mb-3 text-center mobile-radio-toggle-container">
                    <button type="button" class="btn-toggle-mobile-radio w-100" @onclick="ToggleMobileRadio">
                        <span>📻 @(_isRadioCollapsedMobile ? "Mostrar Sintonizador Neo-Hi-Fi ▼" : "Minimizar Sintonizador ▲")</span>
                    </button>
                </div>

                @if (!_isRadioCollapsedMobile)
                {
                    <div class="sticky-radio-anchor">
                        <RetroRadio />

                        <!-- Tarjeta Bento de Patrocinio Lateral 300x250 (Exclusiva Desktop: aprovecha el espacio sin molestar en móvil) -->
                        <div class="studio-sidebar-sponsor-deck mt-3 d-none d-lg-block">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="sponsor-tag">📻 PATROCINIO HI-FI</span>
                                <span class="sponsor-badge">SPONSOR</span>
                            </div>
                            <div class="sidebar-ad-wrapper">
                                <iframe src="ad-sidebar.html" 
                                        width="300" 
                                        height="250" 
                                        frameborder="0" 
                                        scrolling="no" 
                                        class="adsterra-iframe-sidebar"
                                        title="Patrocinio Lateral Hi-Fi"
                                        sandbox="allow-scripts allow-same-origin allow-popups"
                                        loading="lazy">
                                </iframe>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mini-radio-banner d-lg-none" @onclick="ToggleMobileRadio">
                        <span class="mini-radio-icon">📻</span>
                        <div class="mini-radio-info">
                            <span class="mini-radio-title">@(RadioState.ActiveStation?.Name ?? "Radio Mundial Hi-Fi")</span>
                            <span class="mini-radio-subtitle">@(RadioState.IsPlaying ? "● EN VIVO · Toca para abrir sintonizador" : "Toca para abrir sintonizador analógico")</span>
                        </div>
                        <span class="mini-radio-action">Abrir ▾</span>
                    </div>
                }
            </div>

            <!-- Columna Derecha: Barra Protagonista Glassmorphism + Grid Bento -->
            <div class="studio-right-deck">
                @RenderFilterConsole()
                @RenderStationsGrid()
                @RenderSponsorSlot()
                @RenderSeoFooter()
            </div>

        </div>
    }
    else
    {
        <!-- ==============================================================
             DISPOSICIÓN VERTICAL: SINTONIZADOR CENTRADO ARRIBA
             ============================================================== -->
        <div class="w-100">
            <div class="d-lg-none mb-3 text-center mobile-radio-toggle-container">
                <button type="button" class="btn-toggle-mobile-radio w-100" @onclick="ToggleMobileRadio">
                    <span>📻 @(_isRadioCollapsedMobile ? "Mostrar Sintonizador Neo-Hi-Fi ▼" : "Minimizar Sintonizador ▲")</span>
                </button>
            </div>

            @if (!_isRadioCollapsedMobile)
            {
                <div class="mb-4 text-center">
                    <RetroRadio />
                </div>
            }
            else
            {
                <div class="mini-radio-banner d-lg-none mb-3" @onclick="ToggleMobileRadio">
                    <span class="mini-radio-icon">📻</span>
                    <div class="mini-radio-info">
                        <span class="mini-radio-title">@(RadioState.ActiveStation?.Name ?? "Radio Mundial Hi-Fi")</span>
                        <span class="mini-radio-subtitle">@(RadioState.IsPlaying ? "● EN VIVO · Toca para abrir sintonizador" : "Toca para abrir sintonizador analógico")</span>
                    </div>
                    <span class="mini-radio-action">Abrir ▾</span>
                </div>
            }

            @RenderFilterConsole()
            @RenderStationsGrid()
            @RenderSponsorSlot()
            @RenderSeoFooter()
        </div>
    }
</div>

@* RenderFragment: Consola de Búsqueda y Filtros Bento Glassmorphism *@
@code {
    private RenderFragment RenderFilterConsole() => __builder =>
    {
        <section class="master-console-deck p-3 p-md-4 mb-4" aria-label="Consola de Búsqueda y Sintonización">
            
            <!-- Semántica SEO para Motores de Búsqueda (Sin alterar la interfaz visual) -->
            <div class="visually-hidden" style="position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important; margin: -1px !important; overflow: hidden !important; clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; border: 0 !important;">
                <h1>Escuchar estaciones de radio en vivo gratis de todo el mundo</h1>
                <h2>Explorar radios por país, estado o género</h2>
            </div>

            <!-- Fila 1: Buscador Protagonista Glassmorphism + Selector de Filtros Avanzados y Layout -->
            <div class="search-bar-row mb-3">
                <div class="studio-search-wrapper">
                    <span class="search-icon-symbol">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" 
                           class="studio-search-field" 
                           placeholder="Buscar por emisora, país, ciudad, género o frecuencia (ej. 102.5, Chiapas)..." 
                           value="@RadioState.SearchQuery" 
                           @oninput="OnSearchInput" />
                    @if (!string.IsNullOrWhiteSpace(RadioState.SearchQuery))
                    {
                        <button class="btn-clear-input" @onclick='() => RadioState.SetSearchQuery(string.Empty)' title="Borrar búsqueda">✕</button>
                    }
                </div>

                <div class="search-actions-group">
                    <!-- Botón Toggle de Filtros Avanzados -->
                    <button type="button" 
                            class="btn-toggle-advanced-filters @(_showAdvancedFilters ? "filters-open" : "")" 
                            @onclick="ToggleAdvancedFilters"
                            title="Desplegar u ocultar filtros avanzados de ubicación y género">
                        <span class="filters-icon">🎛️</span>
                        <span class="filters-btn-text">Filtros</span>
                        @if (GetActiveFiltersCount() > 0)
                        {
                            <span class="active-badge-pill">@GetActiveFiltersCount()</span>
                        }
                        <span class="arrow-indicator">@(_showAdvancedFilters ? "▲" : "▼")</span>
                    </button>

                    <!-- Botón Alternar Disposición (Solo pantallas grandes) -->
                    <button type="button" 
                            class="btn-layout-toggle d-none d-lg-inline-flex align-items-center gap-1" 
                            @onclick="ToggleLayoutMode" 
                            title="Alternar entre panel lateral o vista superior">
                        <span>@(IsSideBySide ? "◫ Lateral" : "▤ Arriba")</span>
                    </button>
                </div>
            </div>

            <!-- Fila 2: Filtros Desplegables en Cuadrícula Bento (Colapsable) -->
            @if (_showAdvancedFilters)
            {
                <div class="dropdowns-filter-grid mb-3">
                    <!-- Desplegable 1: Continente -->
                    <div class="filter-col">
                        <label class="filter-field-label">
                            <span class="filter-icon">🌐</span>
                            <span>@RadioState.T("CONTINENT")</span>
                        </label>
                        <select class="form-select studio-dropdown-select" 
                                value="@RadioState.SelectedContinent" 
                                @onchange="OnContinentChanged">
                            <option value="Todos">🌐 @RadioState.T("CONTINENT_ALL")</option>
                            <option value="América">🌎 América</option>
                            <option value="Europa">🌍 Europa</option>
                            <option value="Asia">🌏 Asia</option>
                            <option value="África">🌍 África</option>
                            <option value="Oceanía">🌏 Oceanía</option>
                        </select>
                    </div>

                    <!-- Desplegable 2: País -->
                    <div class="filter-col">
                        <label class="filter-field-label">
                            <span class="filter-icon">🌎</span>
                            <span>@RadioState.T("COUNTRY")</span>
                        </label>
                        <select class="form-select studio-dropdown-select" 
                                value="@RadioState.SelectedCountry" 
                                @onchange="OnCountryChanged">
                            <option value="Todos">🌎 @RadioState.T("COUNTRY_ALL")</option>
                            @foreach (var c in RadioState.GetAvailableCountries())
                            {
                                <option value="@c">@GetCountryFlag(c) @c</option>
                            }
                        </select>
                    </div>

                    <!-- Desplegable 3: Estado / Región -->
                    <div class="filter-col">
                        <label class="filter-field-label">
                            <span class="filter-icon">📍</span>
                            <span>@RadioState.T("STATE")</span>
                        </label>
                        <select class="form-select studio-dropdown-select" 
                                value="@RadioState.SelectedState" 
                                @onchange="OnStateChanged">
                            <option value="Todos">📍 @RadioState.T("STATE_ALL")</option>
                            @foreach (var stateName in RadioState.GetAvailableStates())
                            {
                                <option value="@stateName">@stateName</option>
                            }
                        </select>
                    </div>

                    <!-- Desplegable 4: Ciudad -->
                    <div class="filter-col">
                        <label class="filter-field-label">
                            <span class="filter-icon">🏙️</span>
                            <span>@RadioState.T("CITY")</span>
                        </label>
                        <select class="form-select studio-dropdown-select" 
                                value="@RadioState.SelectedCity" 
                                @onchange="OnCityChanged">
                            <option value="Todas">🏙️ @RadioState.T("CITY_ALL")</option>
                            @foreach (var city in RadioState.GetAvailableCities())
                            {
                                <option value="@city">@city</option>
                            }
                        </select>
                    </div>

                    <!-- Desplegable 5: Género Musical -->
                    <div class="filter-col">
                        <label class="filter-field-label">
                            <span class="filter-icon">🎵</span>
                            <span>@RadioState.T("GENRE")</span>
                        </label>
                        <select class="form-select studio-dropdown-select" 
                                value="@RadioState.SelectedGenre" 
                                @onchange="OnGenreChanged">
                            <option value="Todos">🎵 @RadioState.T("GENRE_ALL")</option>
                            @foreach (var g in RadioState.FilterOptions.Genres)
                            {
                                <option value="@g">@g</option>
                            }
                        </select>
                    </div>

                    <!-- Selector Unificado de Banda (FM / AM / TODAS) -->
                    <div class="filter-col band-col">
                        <label class="filter-field-label">
                            <span class="filter-icon">📻</span>
                            <span>@RadioState.T("BAND")</span>
                        </label>
                        <div class="band-segmented-pill">
                            <button type="button" class="btn-band-chip @(RadioState.SelectedBand == "TODAS" ? "chip-active" : "")" 
                                    @onclick='() => RadioState.SetBandFilter("TODAS")'>TODAS</button>
                            <button type="button" class="btn-band-chip @(RadioState.SelectedBand == "FM" ? "chip-active" : "")" 
                                    @onclick='() => RadioState.SetBandFilter("FM")'>FM</button>
                            <button type="button" class="btn-band-chip @(RadioState.SelectedBand == "AM" ? "chip-active" : "")" 
                                    @onclick='() => RadioState.SetBandFilter("AM")'>AM</button>
                        </div>
                    </div>
                </div>
            }

            <!-- Fila 3: Chips de Filtros Activos (Descartables) -->
            @if (HasActiveFilters())
            {
                <div class="active-chips-toolbar d-flex flex-wrap align-items-center gap-2 pt-2 border-top-console">
                    <span class="active-chips-label">Filtros activos:</span>
                    
                    @if (RadioState.SelectedContinent != "Todos")
                    {
                        <button type="button" class="active-filter-badge" @onclick='() => RadioState.SetContinentFilter("Todos")' title="Quitar filtro de continente">
                            <span>@RadioState.SelectedContinent</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (RadioState.SelectedCountry != "Todos")
                    {
                        <button type="button" class="active-filter-badge" @onclick='() => RadioState.SetCountryFilter("Todos")' title="Quitar filtro de país">
                            <span>@RadioState.SelectedCountry</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (RadioState.SelectedState != "Todos")
                    {
                        <button type="button" class="active-filter-badge" @onclick='() => RadioState.SetStateFilter("Todos")' title="Quitar filtro de estado">
                            <span>@RadioState.SelectedState</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (RadioState.SelectedCity != "Todas")
                    {
                        <button type="button" class="active-filter-badge" @onclick='() => RadioState.SetCityFilter("Todas")' title="Quitar filtro de ciudad">
                            <span>@RadioState.SelectedCity</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (RadioState.SelectedGenre != "Todos")
                    {
                        <button type="button" class="active-filter-badge" @onclick='() => RadioState.SetGenreFilter("Todos")' title="Quitar filtro de género">
                            <span>@RadioState.SelectedGenre</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (RadioState.SelectedBand != "TODAS")
                    {
                        <button type="button" class="active-filter-badge" @onclick='() => RadioState.SetBandFilter("TODAS")' title="Quitar filtro de banda">
                            <span>@RadioState.SelectedBand</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(RadioState.SearchQuery))
                    {
                        <button type="button" class="active-filter-badge" @onclick='() => RadioState.SetSearchQuery(string.Empty)' title="Quitar búsqueda">
                            <span>"@RadioState.SearchQuery"</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }

                    <button type="button" class="btn-reset-filters ms-auto" @onclick="RadioState.ResetFilters" title="Restablecer todos los filtros">
                        @RadioState.T("RESET")
                    </button>
                </div>
            }

            <!-- Enlace sutil para la Guía Técnica FM/AM -->
            <div class="d-flex justify-content-end align-items-center mt-2">
                <button type="button" class="btn-guide-toggle-small" @onclick="ToggleFmAmGuide">
                    <span>@(ShowFmAmGuide ? "Ocultar Guía Técnica FM / AM" : "📡 Diferencia entre FM y AM")</span>
                </button>
            </div>

            <!-- Guía Técnica FM vs AM (Desplegable Bento) -->
            @if (ShowFmAmGuide)
            {
                <div class="fm-am-guide-card p-3 p-md-4 mt-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="guide-badge">📡 GUÍA TÉCNICA HI-FI</span>
                            <h4 class="guide-title mb-0">Arquitectura de Bandas: FM vs AM</h4>
                        </div>
                        <button type="button" class="btn-close-guide" @onclick="() => ShowFmAmGuide = false">✕</button>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="guide-box box-fm p-3 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="guide-box-header">⚡ FM (Frecuencia Modulada)</span>
                                    <span class="guide-freq-pill">87.5 – 108.0 MHz</span>
                                </div>
                                <ul class="guide-list mb-0">
                                    <li><b>Calidad Hi-Fi:</b> Estéreo de alta fidelidad, rango dinámico amplio y nulo ruido de estática.</li>
                                    <li><b>Inmunidad:</b> Resistente a tormentas y ruido eléctrico industrial.</li>
                                    <li><b>Cobertura:</b> Línea de vista directa (50 – 100 km).</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="guide-box box-am p-3 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="guide-box-header">📡 AM (Amplitud Modulada)</span>
                                    <span class="guide-freq-pill">540 – 1600 kHz</span>
                                </div>
                                <ul class="guide-list mb-0">
                                    <li><b>Claridad Vocal:</b> Señal monoaural optimizada para radio hablada, deportes y noticias.</li>
                                    <li><b>Gran Alcance:</b> Miles de kilómetros mediante rebote nocturno en la ionosfera.</li>
                                    <li><b>Uso:</b> Cobertura en serranías, costas y zonas rurales.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </section>
    };

    private RenderFragment RenderSponsorSlot() => __builder =>
    {
        <aside class="studio-sponsor-deck p-3 mb-4" aria-label="Espacio de Patrocinio y Publicidad">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="sponsor-tag">📻 PATROCINIO HI-FI</span>
                    <span class="sponsor-subtag d-none d-sm-inline">ESPACIO DISCRETO SIN POPUNDERS</span>
                </div>
                <span class="sponsor-badge">SPONSOR</span>
            </div>

            <!-- Banner Oficial 728x90 para Pantallas Medianas y Grandes (Tablet / Desktop) -->
            <div class="sponsor-ad-slot d-none d-md-flex justify-content-center" id="radio-mundial-ad-slot">
                <iframe src="ad-banner.html" 
                        width="728" 
                        height="90" 
                        frameborder="0" 
                        scrolling="no" 
                        class="adsterra-iframe-banner"
                        title="Patrocinio y Publicidad"
                        sandbox="allow-scripts allow-same-origin allow-popups"
                        loading="lazy">
                </iframe>
            </div>

            <!-- Banner 300x250 Optimizado para Teléfonos Móviles (No se deforma, encaja nativo) -->
            <div class="sponsor-ad-slot-mobile d-flex d-md-none justify-content-center" id="radio-mundial-ad-slot-mobile">
                <iframe src="ad-sidebar.html" 
                        width="300" 
                        height="250" 
                        frameborder="0" 
                        scrolling="no" 
                        class="adsterra-iframe-sidebar"
                        title="Patrocinio y Publicidad Móvil"
                        sandbox="allow-scripts allow-same-origin allow-popups"
                        loading="lazy">
                </iframe>
            </div>
        </aside>
    };

    private RenderFragment RenderStationsGrid() => __builder =>
    {
        @if (RadioState.FilteredStations.Count == 0)
        {
            <div class="empty-stations-deck text-center py-5 my-3 p-4">
                <div class="empty-icon mb-3">📻</div>
                <h4 class="fw-bold mb-2">@RadioState.T("EMPTY_TITLE")</h4>
                <p class="text-muted small mb-4">
                    @RadioState.T("EMPTY_DESC")
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <button type="button" class="btn-tune-retro px-4 py-2" @onclick="RadioState.ResetFilters">
                        @RadioState.T("EMPTY_BTN")
                    </button>
                    <button type="button" class="btn-suggest-empty-btn px-4 py-2" @onclick="() => RadioState.OpenFeedbackModal()">
                        ✍️ Sugerir Emisora para esta Zona
                    </button>
                </div>
            </div>
        }
        else
        {
            var totalCount = RadioState.FilteredStations.Count;
            var totalPages = Math.Max(1, (int)Math.Ceiling((double)totalCount / _pageSize));
            if (_currentPage > totalPages) _currentPage = totalPages;
            if (_currentPage < 1) _currentPage = 1;

            var startIndex = (_currentPage - 1) * _pageSize;
            var pagedStations = RadioState.FilteredStations.Skip(startIndex).Take(_pageSize).ToList();
            var endIndex = Math.Min(startIndex + _pageSize, totalCount);

            <!-- Barra Superior de Control de Paginado y Densidad -->
            <div class="pagination-cockpit-bar mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 px-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="pagination-info-badge">
                        📻 Emisoras <b>@(startIndex + 1)</b>–<b>@endIndex</b> de <b>@totalCount</b>
                    </span>
                    <span class="pagination-page-badge d-none d-sm-inline-flex">
                        Página <b>@_currentPage</b> / <b>@totalPages</b>
                    </span>
                </div>

                <!-- Selector de Emisoras por Pantalla -->
                <div class="page-size-selector d-flex align-items-center gap-2 ms-auto">
                    <span class="page-size-title d-none d-md-inline">Por página:</span>
                    <div class="page-size-chip-group">
                        @foreach (var size in new[] { 6, 9, 12, 18 })
                        {
                            var s = size;
                            <button type="button" 
                                    class="page-size-chip @(_pageSize == s ? "chip-active" : "")" 
                                    @onclick="() => SetPageSize(s)" 
                                    title="Mostrar @s emisoras por pantalla">
                                @s
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Encabezado Semántico H2 del Catálogo de Emisoras (Accesible para Googlebot) -->
            <h2 class="visually-hidden">Emisoras populares de México y Latinoamérica</h2>

            <!-- Bento Cards Grid de Emisoras (Estilo Dribbble) -->
            <div class="stations-responsive-grid mb-4">
                @foreach (var station in pagedStations)
                {
                    var isCurrent = RadioState.ActiveStation?.Id == station.Id;
                    var isPlayingThis = isCurrent && RadioState.IsPlaying;
                    var isFavorite = RadioState.FavoriteStationIds.Contains(station.Id);
                    var isAm = station.Band.Equals("AM", StringComparison.OrdinalIgnoreCase) || station.Frequency > 150;

                    <div class="station-grid-item">
                        <div class="retro-station-card @(isCurrent ? "card-station-active" : "")">
                            
                            <!-- Header de la Bento Card -->
                            <div class="card-station-header">
                                <div class="station-thumb-wrapper @(isPlayingThis ? "thumb-active" : "")">
                                    <img src="@station.LogoUrl" alt="@station.Name - Escuchar radio en vivo online" class="station-thumb-img" loading="lazy" />
                                    @if (isPlayingThis)
                                    {
                                        <div class="thumb-equalizer-overlay">
                                            <div class="eq-bar bar-1"></div>
                                            <div class="eq-bar bar-2"></div>
                                            <div class="eq-bar bar-3"></div>
                                        </div>
                                    }
                                </div>

                                <div class="station-header-text">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="frequency-badge @(isAm ? "badge-am" : "badge-fm")">
                                             @station.Frequency.ToString(isAm ? "F0" : "F1") @station.Band
                                        </span>
                                        <div class="d-flex align-items-center gap-1">
                                            <button type="button" class="btn-report-card" 
                                                    @onclick="() => RadioState.OpenFeedbackModal(station.Name)"
                                                    title="Reportar problema de @station.Name"
                                                    aria-label="Reportar problema de transmisión con @station.Name">
                                                ⚠️
                                            </button>
                                            <button type="button" class="btn-favorite @(isFavorite ? "favorite-active" : "")" 
                                                    @onclick="() => RadioState.ToggleFavoriteAsync(station.Id)"
                                                    title="@(isFavorite ? "Quitar de favoritas" : "Guardar en favoritas")"
                                                    aria-label="@(isFavorite ? "Quitar de favoritas " + station.Name : "Guardar en favoritas " + station.Name)">
                                                ★
                                            </button>
                                        </div>
                                    </div>

                                    <h3 class="station-name text-truncate" title="@station.Name">
                                        @station.Name
                                    </h3>
                                    
                                    <div class="station-geo-tag text-truncate">
                                        📍 @station.City, @station.State (@station.CountryCode)
                                    </div>
                                </div>
                            </div>

                            <!-- Descripción alineada con line-clamp -->
                            <p class="station-description">
                                @(string.IsNullOrWhiteSpace(station.Description) ? "Transmisión en vivo con audio digital de alta fidelidad." : station.Description)
                            </p>

                            <!-- Footer de la Bento Card -->
                            <div class="card-station-footer">
                                <div class="station-meta-tags">
                                    <span class="genre-pill">@station.Genre</span>
                                    <span class="bitrate-tag">@station.Bitrate</span>
                                </div>

                                <button type="button" 
                                        class="btn-tune-retro @(isPlayingThis ? "btn-playing" : "")" 
                                        @onclick="() => HandleTuneClick(station)"
                                        aria-label="@(isPlayingThis ? "Pausar sintonía de " + station.Name : "Sintonizar " + station.Name)">
                                    @if (isPlayingThis)
                                    {
                                        <span>⏸ Sintonizada</span>
                                    }
                                    else
                                    {
                                        <span>▶ Sintonizar</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Navegación de Páginas Inferior (Bento Hi-Fi) -->
            @if (totalPages > 1)
            {
                <nav class="pagination-nav-footer d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 px-3 mt-2" aria-label="Navegación de emisoras">
                    <div class="nav-btn-group d-flex align-items-center gap-1">
                        <button type="button" class="btn-retro-nav-page" 
                                disabled="@(_currentPage <= 1)" 
                                @onclick="() => ChangePage(1)" 
                                title="Primera página">
                            ⏮ Primero
                        </button>
                        <button type="button" class="btn-retro-nav-page" 
                                disabled="@(_currentPage <= 1)" 
                                @onclick="() => ChangePage(_currentPage - 1)" 
                                title="Página anterior">
                            ◀ Anterior
                        </button>
                    </div>

                    <div class="nav-numbers-group d-flex align-items-center gap-1">
                        @foreach (var pageNum in GetVisiblePageNumbers(totalPages))
                        {
                            if (pageNum == -1)
                            {
                                <span class="nav-page-ellipsis">…</span>
                            }
                            else
                            {
                                var p = pageNum;
                                <button type="button" 
                                        class="btn-retro-number @(_currentPage == p ? "number-active" : "")" 
                                        @onclick="() => ChangePage(p)">
                                    @p
                                </button>
                            }
                        }
                    </div>

                    <div class="nav-btn-group d-flex align-items-center gap-1">
                        <button type="button" class="btn-retro-nav-page" 
                                disabled="@(_currentPage >= totalPages)" 
                                @onclick="() => ChangePage(_currentPage + 1)" 
                                title="Página siguiente">
                            Siguiente ▶
                        </button>
                        <button type="button" class="btn-retro-nav-page" 
                                disabled="@(_currentPage >= totalPages)" 
                                @onclick="() => ChangePage(totalPages)" 
                                title="Última página">
                            Último ⏭
                        </button>
                    </div>
                </nav>
            }
        }
    };

    private RenderFragment RenderSeoFooter() => __builder =>
    {
        <footer class="visually-hidden" aria-label="Información y Guía de Radio Mundial">
            <h3>Radio en Vivo Gratis y sin Cortes</h3>
            <p>Radio Mundial te permite escuchar estaciones de radio en vivo gratis por internet en cualquier teléfono móvil, tablet o computadora. Disfruta de transmisiones directas de audio de alta fidelidad (Hi-Fi) sin registro y sin descargas de aplicaciones.</p>
            <h3>Emisoras de México y el Mundo</h3>
            <p>Sintoniza estaciones de radio organizadas por estado, municipio y localidad de México cubriendo los 32 estados de la República Mexicana, junto a miles de frecuencias en vivo de España, Colombia, Argentina, Estados Unidos y más de 230 países.</p>
            <h3>Música, Noticias y Deportes Online</h3>
            <p>Explora por frecuencias FM y AM, pop latino, regional mexicano, noticias en tiempo real, baladas, rock clásico, jazz y deportes en vivo con un sintonizador retro analógico interactivo.</p>
        </footer>
    };
}

@code {
    private bool IsSideBySide { get; set; } = true;
    private bool ShowFmAmGuide { get; set; } = false;
    private bool _isRadioCollapsedMobile = false;
    private bool _showAdvancedFilters = true;
    private int _currentPage = 1;
    private int _pageSize = 9;

    private void ToggleMobileRadio()
    {
        _isRadioCollapsedMobile = !_isRadioCollapsedMobile;
    }

    private void ToggleAdvancedFilters()
    {
        _showAdvancedFilters = !_showAdvancedFilters;
    }

    private int GetActiveFiltersCount()
    {
        int count = 0;
        if (RadioState.SelectedContinent != "Todos") count++;
        if (RadioState.SelectedCountry != "Todos") count++;
        if (RadioState.SelectedState != "Todos") count++;
        if (RadioState.SelectedCity != "Todas") count++;
        if (RadioState.SelectedGenre != "Todos") count++;
        if (RadioState.SelectedBand != "TODAS") count++;
        return count;
    }

    private void SetPageSize(int size)
    {
        _pageSize = size;
        _currentPage = 1;
    }

    private void ChangePage(int page)
    {
        var totalPages = Math.Max(1, (int)Math.Ceiling((double)RadioState.FilteredStations.Count / _pageSize));
        _currentPage = Math.Clamp(page, 1, totalPages);
    }

    private void ResetPagination()
    {
        _currentPage = 1;
    }

    private IEnumerable<int> GetVisiblePageNumbers(int totalPages)
    {
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) yield return i;
            yield break;
        }

        yield return 1;

        int start = Math.Max(2, _currentPage - 1);
        int end = Math.Min(totalPages - 1, _currentPage + 1);

        if (start > 2)
        {
            yield return -1;
        }

        for (int i = start; i <= end; i++)
        {
            yield return i;
        }

        if (end < totalPages - 1)
        {
            yield return -1;
        }

        yield return totalPages;
    }

