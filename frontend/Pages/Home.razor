@page "/"
@using frontend.Models
@using frontend.Services
@inject RadioStateService RadioState
@implements IDisposable

<PageTitle>Radio Mundial | Transmisión Directa Global</PageTitle>

<div class="studio-cockpit-container px-3 px-md-4 py-2">
    <!-- Barra Superior Compacta de Estudio -->
    <header class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2 studio-header-bar">
        <div class="d-flex align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-vintage-live">@RadioState.T("LIVE")</span>
                    <span class="studio-subtext">@RadioState.T("SUBTITLE")</span>
                </div>
                <h1 class="h3 fw-black tracking-tight mb-0 studio-title">
                    Radio <span class="text-amber">Mundial</span>
                </h1>
            </div>
        </div>

        <!-- Controles de Estudio: Tema (Claro/Oscuro/Sistema), Idioma (ES/EN), Disposición y Métricas -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            
            <!-- Selector de Tema (Oscuro / Claro / Sistema) -->
            <div class="theme-segmented-switch" title="Tema: Oscuro / Claro / Sistema">
                <button class="btn-theme-chip @(RadioState.CurrentTheme == "dark" ? "theme-active" : "")" 
                        @onclick='() => RadioState.SetThemeAsync("dark")' title="Modo Oscuro">
                    🌙
                </button>
                <button class="btn-theme-chip @(RadioState.CurrentTheme == "light" ? "theme-active" : "")" 
                        @onclick='() => RadioState.SetThemeAsync("light")' title="Modo Claro">
                    ☀️
                </button>
                <button class="btn-theme-chip @(RadioState.CurrentTheme == "system" ? "theme-active" : "")" 
                        @onclick='() => RadioState.SetThemeAsync("system")' title="Adaptar al Sistema">
                    💻
                </button>
            </div>

            <!-- Selector de Idioma (ES / EN) -->
            <div class="lang-segmented-switch" title="Language / Idioma">
                <button class="btn-lang-chip @(RadioState.CurrentLanguage == "es" ? "lang-active" : "")" 
                        @onclick='() => RadioState.SetLanguageAsync("es")'>
                    ES
                </button>
                <button class="btn-lang-chip @(RadioState.CurrentLanguage == "en" ? "lang-active" : "")" 
                        @onclick='() => RadioState.SetLanguageAsync("en")'>
                    EN
                </button>
            </div>

            <!-- Selector de Disposición Visual (Lateral vs Arriba) -->
            <button class="btn-layout-toggle d-none d-lg-inline-flex align-items-center gap-2" 
                    @onclick="ToggleLayoutMode" 
                    title="Alternar entre panel lateral fijo o vista vertical completa">
                <span>@(IsSideBySide ? RadioState.T("LAYOUT_SIDE") : RadioState.T("LAYOUT_TOP"))</span>
            </button>

            <!-- Métricas de Estudio Analógico -->
            <div class="d-flex align-items-center gap-2 studio-metrics-group">
                <div class="studio-metric-card" title="Estaciones mostradas en pantalla">
                    <span class="metric-val">@RadioState.FilteredStations.Count</span>
                    <span class="metric-sub">@RadioState.T("ON_SCREEN")</span>
                </div>
                <div class="studio-metric-card" title="Estaciones disponibles en catálogo">
                    <span class="metric-val">@RadioState.AllStations.Count</span>
                    <span class="metric-sub">@RadioState.T("AVAILABLE")</span>
                </div>
                <div class="studio-metric-card d-none d-sm-flex" title="Oyentes sintonizados">
                    <span class="metric-val">@RadioState.ListenersCount</span>
                    <span class="metric-sub">@RadioState.T("LISTENERS")</span>
                </div>
                <div class="status-connection-indicator @(RadioState.IsConnected ? "is-online" : "is-offline")" 
                     title="@RadioState.ConnectionStatusText">
                    <span class="dot-led"></span>
                    <span class="connection-label">@(RadioState.IsConnected ? RadioState.T("CONNECTED") : RadioState.T("RECONNECTING"))</span>
                </div>
            </div>
        </div>
    </header>

    @if (IsSideBySide)
    {
        <!-- ==============================================================
             DISPOSICIÓN LATERAL (COCKPIT): LA RADIO NUNCA SE PIERDE DE VISTA
             ============================================================== -->
        <div class="row g-3 g-xl-4 align-items-start">
            
            <!-- Columna Izquierda: Radio Retro Fija (Sticky Dock) -->
            <div class="col-12 col-lg-5 col-xl-5 col-xxl-4 studio-left-dock">
                <div class="sticky-radio-anchor">
                    <RetroRadio />
                </div>
            </div>

            <!-- Columna Derecha: Consola de Filtros y Rejilla de Emisoras -->
            <div class="col-12 col-lg-7 col-xl-7 col-xxl-8 studio-right-deck">
                <!-- Consola Maestra de Filtros (Limpia, Desplegable, Sin Amontonamientos) -->
                @RenderFilterConsole()

                <!-- Grid de Emisoras Filtradas -->
                @RenderStationsGrid()
            </div>

        </div>
    }
    else
    {
        <!-- ==============================================================
             DISPOSICIÓN TRADICIONAL (RADIO ARRIBA / FILTROS ABAJO)
             ============================================================== -->
        <div class="w-100">
            <div class="mb-3 text-center">
                <RetroRadio />
            </div>

            @RenderFilterConsole()

            @RenderStationsGrid()
        </div>
    }
</div>

@* RenderFragment: Consola de Filtros Moderna, Ergonómica y Limpia *@
@code {
    private RenderFragment RenderFilterConsole() => __builder =>
    {
        <section class="master-console-deck p-3 mb-4" aria-label="Consola de Búsqueda y Sintonización">
            
            <!-- Fila 1: Barra Principal de Búsqueda Instantánea -->
            <div class="search-bar-row mb-3">
                <div class="studio-search-wrapper">
                    <span class="search-icon-symbol">🔍</span>
                    <input type="text" 
                           class="studio-search-field" 
                           placeholder="Buscar por país, estado, ciudad, frecuencia (ej. 90.5), género o emisora..." 
                           value="@RadioState.SearchQuery" 
                           @oninput="OnSearchInput" />
                    @if (!string.IsNullOrWhiteSpace(RadioState.SearchQuery))
                    {
                        <button class="btn-clear-input" @onclick='() => RadioState.SetSearchQuery(string.Empty)' title="Borrar búsqueda">✕</button>
                    }
                </div>
            </div>

            <!-- Fila 2: Barra de Filtros Desplegables en Cuadrícula Compacta y Ordenada -->
            <div class="dropdowns-filter-grid mb-2">
                
                <!-- Desplegable 1: País -->
                <div class="filter-col">
                    <label class="filter-field-label">🌍 @RadioState.T("COUNTRY")</label>
                    <select class="form-select studio-dropdown-select" 
                            value="@RadioState.SelectedCountry" 
                            @onchange="OnCountryChanged">
                        <option value="Todos">🌐 @RadioState.T("COUNTRY_ALL")</option>
                        @foreach (var c in TopCountries.Where(x => x.Name != "Todos"))
                        {
                            <option value="@c.Name">@c.Flag @c.Name</option>
                        }
                    </select>
                </div>

                <!-- Desplegable 2: Estado / Región -->
                <div class="filter-col">
                    <label class="filter-field-label">📍 @RadioState.T("STATE")</label>
                    <select class="form-select studio-dropdown-select" 
                            value="@RadioState.SelectedState" 
                            @onchange="OnStateChanged">
                        <option value="Todos">📍 @RadioState.T("STATE_ALL")</option>
                        @foreach (var stateName in GetAvailableStates())
                        {
                            <option value="@stateName">@stateName</option>
                        }
                    </select>
                </div>

                <!-- Desplegable 3: Ciudad -->
                <div class="filter-col">
                    <label class="filter-field-label">🏙️ @RadioState.T("CITY")</label>
                    <select class="form-select studio-dropdown-select" 
                            value="@RadioState.SelectedCity" 
                            @onchange="OnCityChanged">
                        <option value="Todas">🏙️ @RadioState.T("CITY_ALL")</option>
                        @foreach (var city in GetAvailableCities())
                        {
                            <option value="@city">@city</option>
                        }
                    </select>
                </div>

                <!-- Desplegable 4: Género Musical -->
                <div class="filter-col">
                    <label class="filter-field-label">🎵 @RadioState.T("GENRE")</label>
                    <select class="form-select studio-dropdown-select" 
                            value="@RadioState.SelectedGenre" 
                            @onchange="OnGenreChanged">
                        <option value="Todos">🎵 @RadioState.T("GENRE_ALL")</option>
                        @foreach (var g in RadioState.FilterOptions.Genres)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </div>

                <!-- Selector de Banda (FM / AM / TODAS) -->
                <div class="filter-col band-col">
                    <label class="filter-field-label">📻 @RadioState.T("BAND")</label>
                    <div class="band-segmented-pill">
                        <button class="btn-band-chip @(RadioState.SelectedBand == "TODAS" ? "chip-active" : "")" 
                                @onclick='() => RadioState.SetBandFilter("TODAS")'>TODAS</button>
                        <button class="btn-band-chip @(RadioState.SelectedBand == "FM" ? "chip-active" : "")" 
                                @onclick='() => RadioState.SetBandFilter("FM")'>FM</button>
                        <button class="btn-band-chip @(RadioState.SelectedBand == "AM" ? "chip-active" : "")" 
                                @onclick='() => RadioState.SetBandFilter("AM")'>AM</button>
                    </div>
                </div>

            </div>

            <!-- Fila 3: Chips de Filtros Activos (Descartables con 1 Clic) -->
            @if (HasActiveFilters())
            {
                <div class="active-chips-toolbar d-flex flex-wrap align-items-center gap-2 pt-2 border-top-console">
                    <span class="active-chips-label">Filtros activos:</span>
                    
                    @if (RadioState.SelectedCountry != "Todos")
                    {
                        <button class="active-filter-badge" @onclick='() => RadioState.SetCountryFilter("Todos")' title="Quitar filtro">
                            <span>@RadioState.SelectedCountry</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (RadioState.SelectedState != "Todos")
                    {
                        <button class="active-filter-badge" @onclick='() => RadioState.SetStateFilter("Todos")' title="Quitar filtro">
                            <span>@RadioState.SelectedState</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (RadioState.SelectedCity != "Todas")
                    {
                        <button class="active-filter-badge" @onclick='() => RadioState.SetCityFilter("Todas")' title="Quitar filtro">
                            <span>@RadioState.SelectedCity</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (RadioState.SelectedGenre != "Todos")
                    {
                        <button class="active-filter-badge" @onclick='() => RadioState.SetGenreFilter("Todos")' title="Quitar filtro">
                            <span>@RadioState.SelectedGenre</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (RadioState.SelectedBand != "TODAS")
                    {
                        <button class="active-filter-badge" @onclick='() => RadioState.SetBandFilter("TODAS")' title="Quitar filtro">
                            <span>@RadioState.SelectedBand</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(RadioState.SearchQuery))
                    {
                        <button class="active-filter-badge" @onclick='() => RadioState.SetSearchQuery(string.Empty)' title="Quitar filtro">
                            <span>"@RadioState.SearchQuery"</span>
                            <span class="badge-close">✕</span>
                        </button>
                    }

                    <button class="btn-reset-filters ms-auto" @onclick="RadioState.ResetFilters" title="Restablecer todos los filtros">
                        @RadioState.T("RESET")
                    </button>
                </div>
            }

            <!-- Botón Opcional para Guía Explicativa FM vs AM -->
            <div class="d-flex justify-content-end mt-2">
                <button class="btn-guide-toggle-small" @onclick="ToggleFmAmGuide">
                    <span>@(ShowFmAmGuide ? "Ocultar Guía FM/AM" : "¿Cuál es la diferencia entre FM y AM?")</span>
                </button>
            </div>

            <!-- Guía Explicativa FM vs AM (Desplegable) -->
            @if (ShowFmAmGuide)
            {
                <div class="fm-am-guide-card p-3 p-md-4 mt-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="guide-badge">📡 GUÍA TÉCNICA</span>
                            <h4 class="guide-title mb-0">Diferencia entre FM y AM</h4>
                        </div>
                        <button class="btn-close-guide" @onclick="() => ShowFmAmGuide = false">✕</button>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="guide-box box-fm p-3 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="guide-box-header">⚡ FM (Frecuencia Modulada)</span>
                                    <span class="guide-freq-pill">88.0 – 108.0 MHz</span>
                                </div>
                                <ul class="guide-list mb-0">
                                    <li><b>Calidad de Sonido:</b> Alta fidelidad (Hi-Fi) estéreo cristalino con ancho de banda completo.</li>
                                    <li><b>Inmunidad:</b> Resistente a ruidos estáticos, tormentas eléctricas y cables de alta tensión.</li>
                                    <li><b>Alcance:</b> Línea de visión directa (50 a 100 km). Las ondas atraviesan la atmósfera.</li>
                                    <li><b>Uso:</b> Música, juventud, emisoras metropolitanas y sonido inmersivo.</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="guide-box box-am p-3 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="guide-box-header">📡 AM (Amplitud Modulada)</span>
                                    <span class="guide-freq-pill">540 – 1600 kHz</span>
                                </div>
                                <ul class="guide-list mb-0">
                                    <li><b>Calidad de Sonido:</b> Señal monoaural optimizada para la claridad de la voz humana y la palabra hablada.</li>
                                    <li><b>Alcance Masivo:</b> Enorme cobertura de cientos o miles de kilómetros. Por la noche, las ondas rebotan en la ionósfera superando montañas.</li>
                                    <li><b>Uso:</b> Noticias, debate político, deportes y cobertura para sierras, costas y zonas rurales.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </section>
    };

    private RenderFragment RenderStationsGrid() => __builder =>
    {
        @if (RadioState.FilteredStations.Count == 0)
        {
            <div class="empty-stations-deck text-center py-5 my-3 p-4">
                <div class="empty-icon mb-2">📻</div>
                <h4 class="fw-bold mb-1">@RadioState.T("EMPTY_TITLE")</h4>
                <p class="text-muted small mb-3">
                    @RadioState.T("EMPTY_DESC")
                </p>
                <button class="btn-tune-retro px-4 py-2" @onclick="RadioState.ResetFilters">
                    @RadioState.T("EMPTY_BTN")
                </button>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-2 row-cols-xxl-3 g-3 mb-5">
                @foreach (var station in RadioState.FilteredStations)
                {
                    var isCurrent = RadioState.ActiveStation?.Id == station.Id;
                    var isPlayingThis = isCurrent && RadioState.IsPlaying;
                    var isFavorite = RadioState.FavoriteStationIds.Contains(station.Id);
                    var isAm = station.Band.Equals("AM", StringComparison.OrdinalIgnoreCase) || station.Frequency > 150;

                    <div class="col">
                        <div class="retro-station-card h-100 @(isCurrent ? "card-station-active" : "")">
                            <div class="card-station-header">
                                <div class="station-thumb-wrapper @(isPlayingThis ? "thumb-spinning" : "")">
                                    <img src="@station.LogoUrl" alt="@station.Name" class="station-thumb-img" loading="lazy" />
                                    @if (isPlayingThis)
                                    {
                                        <div class="thumb-equalizer-overlay">
                                            <div class="eq-bar"></div>
                                            <div class="eq-bar"></div>
                                            <div class="eq-bar"></div>
                                        </div>
                                    }
                                </div>

                                <div class="station-header-text">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="frequency-badge @(isAm ? "badge-am" : "badge-fm")">
                                            @station.Frequency.ToString(isAm ? "F0" : "F1") @station.Band
                                        </span>
                                        <button class="btn-favorite @(isFavorite ? "favorite-active" : "")" 
                                                @onclick="() => RadioState.ToggleFavoriteAsync(station.Id)"
                                                title="@(isFavorite ? "Quitar de favoritas" : "Guardar en favoritas")">
                                            ★
                                        </button>
                                    </div>
                                    <h3 class="station-name text-truncate" title="@station.Name">
                                        @station.Name
                                    </h3>
                                    <div class="station-geo-tag text-truncate">
                                        📍 @station.City, @station.State (@station.CountryCode)
                                    </div>
                                </div>
                            </div>

                            <p class="station-description">
                                @station.Description
                            </p>

                            <div class="card-station-footer">
                                <div class="station-meta-tags">
                                    <span class="genre-pill">@station.Genre</span>
                                    <span class="bitrate-tag">@station.Bitrate</span>
                                </div>

                                <button class="btn-tune-retro @(isPlayingThis ? "btn-playing" : "")" 
                                        @onclick="() => HandleTuneClick(station)">
                                    @if (isPlayingThis)
                                    {
                                        <span>⏸ @RadioState.T("PAUSE")</span>
                                    }
                                    else
                                    {
                                        <span>▶ @RadioState.T("TUNE")</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    };
}

@code {
    private bool IsSideBySide { get; set; } = true;
    private bool ShowFmAmGuide { get; set; } = false;

    private record CountryItem(string Name, string Flag);

    private readonly List<CountryItem> TopCountries =
    [
        new("Todos", "🌐"),
        // Norteamérica
        new("México", "🇲🇽"),
        new("Estados Unidos", "🇺🇸"),
        new("Canadá", "🇨🇦"),
        // Centroamérica
        new("Guatemala", "🇬🇹"),
        new("Costa Rica", "🇨🇷"),
        new("El Salvador", "🇸🇻"),
        new("Honduras", "🇭🇳"),
        new("Nicaragua", "🇳🇮"),
        new("Panamá", "🇵🇦"),
        new("Belice", "🇧🇿"),
        // El Caribe
        new("República Dominicana", "🇩🇴"),
        new("Puerto Rico", "🇵🇷"),
        new("Cuba", "🇨🇺"),
        new("Jamaica", "🇯🇲"),
        // Sudamérica
        new("Colombia", "🇨🇴"),
        new("Argentina", "🇦🇷"),
        new("Brasil", "🇧🇷"),
        new("Chile", "🇨🇱"),
        new("Perú", "🇵🇪"),
        new("Venezuela", "🇻🇪"),
        new("Ecuador", "🇪🇨"),
        new("Bolivia", "🇧🇴"),
        new("Uruguay", "🇺🇾"),
        new("Paraguay", "🇵🇾"),
        // Europa & Asia
        new("España", "🇪🇸"),
        new("Alemania", "🇩🇪"),
        new("Reino Unido", "🇬🇧"),
        new("Francia", "🇫🇷"),
        new("Italia", "🇮🇹"),
        new("Suiza", "🇨🇭"),
        new("Japón", "🇯🇵")
    ];

    protected override void OnInitialized()
    {
        RadioState.OnStateChanged += HandleStateChanged;
    }

    private void ToggleLayoutMode()
    {
        IsSideBySide = !IsSideBySide;
    }

    private void ToggleFmAmGuide()
    {
        ShowFmAmGuide = !ShowFmAmGuide;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool HasActiveFilters()
    {
        return RadioState.SelectedCountry != "Todos" ||
               RadioState.SelectedState != "Todos" ||
               RadioState.SelectedCity != "Todas" ||
               RadioState.SelectedGenre != "Todos" ||
               RadioState.SelectedBand != "TODAS" ||
               !string.IsNullOrWhiteSpace(RadioState.SearchQuery);
    }

    private IEnumerable<string> GetAvailableStates()
    {
        if (RadioState.SelectedCountry == "México" || RadioState.SelectedCountry == "Todos")
        {
            if (RadioState.FilterOptions.States is not null && RadioState.FilterOptions.States.Count > 0)
            {
                return RadioState.FilterOptions.States;
            }
        }

        var states = RadioState.AllStations
            .Where(s => RadioState.SelectedCountry == "Todos" || string.Equals(RadioStateService.NormalizeText(s.Country), RadioStateService.NormalizeText(RadioState.SelectedCountry), StringComparison.OrdinalIgnoreCase))
            .Select(s => s.State)
            .Where(st => !string.IsNullOrEmpty(st) && st != "Nacional")
            .Distinct()
            .OrderBy(st => st)
            .ToList();

        return states.Count > 0 ? states : ["Chiapas", "Ciudad de México", "Jalisco", "Nuevo León", "Oaxaca", "Puebla", "Veracruz"];
    }

    private IEnumerable<string> GetAvailableCities()
    {
        var normCountry = RadioStateService.NormalizeText(RadioState.SelectedCountry);
        var normState = RadioStateService.NormalizeText(RadioState.SelectedState);

        var q = RadioState.AllStations.AsEnumerable();
        if (normCountry != "todos" && !string.IsNullOrEmpty(normCountry))
        {
            q = q.Where(s => RadioStateService.NormalizeText(s.Country) == normCountry || RadioStateService.NormalizeText(s.Country).Contains(normCountry));
        }
        if (normState != "todos" && !string.IsNullOrEmpty(normState))
        {
            q = q.Where(s => RadioStateService.NormalizeText(s.State) == normState || RadioStateService.NormalizeText(s.State).Contains(normState));
        }
        return q.Select(s => s.City).Where(c => !string.IsNullOrEmpty(c) && c != "Nacional").Distinct().OrderBy(c => c);
    }

    private void OnCountryChanged(ChangeEventArgs e)
    {
        RadioState.SetCountryFilter(e.Value?.ToString() ?? "Todos");
    }

    private void OnStateChanged(ChangeEventArgs e)
    {
        RadioState.SetStateFilter(e.Value?.ToString() ?? "Todos");
    }

    private void OnCityChanged(ChangeEventArgs e)
    {
        RadioState.SetCityFilter(e.Value?.ToString() ?? "Todas");
    }

    private void OnGenreChanged(ChangeEventArgs e)
    {
        RadioState.SetGenreFilter(e.Value?.ToString() ?? "Todos");
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        RadioState.SetSearchQuery(e.Value?.ToString() ?? string.Empty);
    }

    private async Task HandleTuneClick(Station station)
    {
        if (RadioState.ActiveStation?.Id == station.Id && RadioState.IsPlaying)
        {
            await RadioState.TogglePlayAsync();
        }
        else
        {
            await RadioState.TuneStationAsync(station);
        }
    }

    public void Dispose()
    {
        RadioState.OnStateChanged -= HandleStateChanged;
    }
}
