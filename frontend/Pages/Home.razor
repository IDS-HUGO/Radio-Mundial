@page "/"
@using frontend.Models
@using frontend.Services
@inject RadioStateService RadioState
@implements IDisposable

<PageTitle>Radio Mundial | Transmisión Directa Global</PageTitle>

<div class="studio-cockpit-container px-3 px-md-4 py-2">
    <!-- Barra Superior Compacta de Estudio -->
    <header class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2 studio-header-bar">
        <div class="d-flex align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-vintage-live">@RadioState.T("LIVE")</span>
                    <span class="studio-subtext">@RadioState.T("SUBTITLE")</span>
                </div>
                <h1 class="h3 fw-black tracking-tight mb-0 studio-title">
                    Radio <span class="text-amber">Mundial</span>
                </h1>
            </div>
        </div>

        <!-- Controles de Estudio: Tema (Claro/Oscuro/Sistema), Idioma (ES/EN), Disposición y Métricas -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            
            <!-- Selector de Tema (Oscuro / Claro / Sistema) -->
            <div class="theme-segmented-switch" title="Tema: Oscuro / Claro / Sistema">
                <button class="btn-theme-chip @(RadioState.CurrentTheme == "dark" ? "theme-active" : "")" 
                        @onclick='() => RadioState.SetThemeAsync("dark")' title="Modo Oscuro">
                    🌙
                </button>
                <button class="btn-theme-chip @(RadioState.CurrentTheme == "light" ? "theme-active" : "")" 
                        @onclick='() => RadioState.SetThemeAsync("light")' title="Modo Claro">
                    ☀️
                </button>
                <button class="btn-theme-chip @(RadioState.CurrentTheme == "system" ? "theme-active" : "")" 
                        @onclick='() => RadioState.SetThemeAsync("system")' title="Adaptar al Sistema">
                    💻
                </button>
            </div>

            <!-- Selector de Idioma (ES / EN) -->
            <div class="lang-segmented-switch" title="Language / Idioma">
                <button class="btn-lang-chip @(RadioState.CurrentLanguage == "es" ? "lang-active" : "")" 
                        @onclick='() => RadioState.SetLanguageAsync("es")'>
                    ES
                </button>
                <button class="btn-lang-chip @(RadioState.CurrentLanguage == "en" ? "lang-active" : "")" 
                        @onclick='() => RadioState.SetLanguageAsync("en")'>
                    EN
                </button>
            </div>

            <!-- Selector de Disposición Visual (Lateral vs Arriba) -->
            <button class="btn-layout-toggle d-none d-lg-inline-flex align-items-center gap-2" 
                    @onclick="ToggleLayoutMode" 
                    title="Alternar entre panel lateral fijo o vista vertical completa">
                <span>@(IsSideBySide ? RadioState.T("LAYOUT_SIDE") : RadioState.T("LAYOUT_TOP"))</span>
            </button>

            <!-- Métricas de Estudio -->
            <div class="studio-metric-chip">
                <span class="metric-num">@RadioState.FilteredStations.Count</span>
                <span class="metric-label">@RadioState.T("SHOWING")</span>
            </div>
            <div class="studio-metric-chip">
                <span class="metric-num">@RadioState.AllStations.Count</span>
                <span class="metric-label">@RadioState.T("AVAILABLE")</span>
            </div>
            <div class="studio-metric-chip">
                <span class="metric-num">@RadioState.ListenersCount</span>
                <span class="metric-label">@RadioState.T("LISTENERS")</span>
            </div>
            <div class="studio-metric-chip @(RadioState.IsConnected ? "chip-connected" : "chip-reconnecting")">
                <span class="metric-led"></span>
                <span class="metric-label">@(RadioState.IsConnected ? RadioState.T("CONNECTED") : RadioState.T("RECONNECTING"))</span>
            </div>
        </div>
    </header>

    @if (IsSideBySide)
    {
        <!-- ==============================================================
             DISPOSICIÓN LATERAL (COCKPIT): LA RADIO NUNCA SE PIERDE DE VISTA
             ============================================================== -->
        <div class="row g-3 g-xl-4 align-items-start">
            
            <!-- Columna Izquierda: Radio Retro Fija (Sticky Dock) -->
            <div class="col-12 col-lg-5 col-xl-5 col-xxl-4 studio-left-dock">
                <div class="sticky-radio-anchor">
                    <RetroRadio />

                    <!-- Monitor Analógico de la Estación en Vivo -->
                    @if (RadioState.ActiveStation is not null)
                    {
                        var isAm = RadioState.ActiveStation.Band.Equals("AM", StringComparison.OrdinalIgnoreCase) || RadioState.ActiveStation.Frequency > 150;
                        <div class="active-station-monitor p-3 mt-2">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="badge-monitor-freq">
                                    @RadioState.ActiveStation.Frequency.ToString(isAm ? "F0" : "F1") @(isAm ? "kHz AM" : "MHz FM")
                                </span>
                                <span class="badge-monitor-status @(RadioState.IsPlaying ? "status-playing" : "")">
                                    @(RadioState.IsPlaying ? (RadioState.CurrentLanguage == "en" ? "● ON AIR" : "● EN EL AIRE") : (RadioState.CurrentLanguage == "en" ? "○ STANDBY" : "○ EN ESPERA"))
                                </span>
                            </div>
                            <div class="monitor-station-title text-truncate" title="@RadioState.ActiveStation.Name">
                                @RadioState.ActiveStation.Name
                            </div>
                            <div class="monitor-station-meta text-truncate">
                                📍 @RadioState.ActiveStation.City, @RadioState.ActiveStation.State (@RadioState.ActiveStation.Country) · @RadioState.ActiveStation.Genre
                            </div>

                            @if (RadioState.IsPlaying)
                            {
                                <div class="monitor-vu-meter mt-2">
                                    @for (int i = 0; i < 18; i++)
                                    {
                                        <div class="vu-led @(i > 14 ? "led-red" : (i > 10 ? "led-yellow" : "led-green"))"></div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Columna Derecha: Consola de Filtros y Rejilla de Emisoras -->
            <div class="col-12 col-lg-7 col-xl-7 col-xxl-8 studio-right-deck">
                <!-- Consola Maestra de Filtros (Sin deslizamientos tediosos) -->
                @RenderFilterConsole()

                <!-- Grid de Emisoras Filtradas -->
                @RenderStationsGrid()
            </div>

        </div>
    }
    else
    {
        <!-- ==============================================================
             DISPOSICIÓN TRADICIONAL (RADIO ARRIBA / FILTROS ABAJO)
             ============================================================== -->
        <div class="w-100">
            <div class="mb-3 text-center">
                <RetroRadio />
            </div>

            @RenderFilterConsole()

            @RenderStationsGrid()
        </div>
    }
</div>

@* RenderFragment: Consola de Filtros *@
@code {
    private RenderFragment RenderFilterConsole() => __builder =>
    {
        <section class="master-console-deck p-3 mb-4" aria-label="Consola de Sintonización">
            
            <!-- 1. Selector de Países con Pastillas Flexibles y Menú Desplegable -->
            <div class="console-section mb-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-2 gap-2">
                    <span class="console-label">@RadioState.T("COUNTRY")</span>
                    
                    <!-- Menú selector directo de cualquier país -->
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm console-select-mini" 
                                value="@RadioState.SelectedCountry" 
                                @onchange="OnCountryChanged">
                            <option value="Todos">@RadioState.T("COUNTRY_ALL")</option>
                            @foreach (var c in TopCountries.Where(x => x.Name != "Todos"))
                            {
                                <option value="@c.Name">@c.Flag @c.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Pastillas de Países en Cuadrícula Flexible (Sin Deslizamiento Forzado) -->
                <div class="country-push-matrix">
                    @foreach (var c in TopCountries)
                    {
                        var isSel = string.Equals(RadioState.SelectedCountry, c.Name, StringComparison.OrdinalIgnoreCase);
                        <button class="btn-console-push @(isSel ? "push-selected" : "")" 
                                @onclick="() => RadioState.SetCountryFilter(c.Name)">
                            <span class="push-led"></span>
                            <span class="push-text">@c.Flag @c.Name</span>
                        </button>
                    }
                </div>
            </div>

            <!-- 2. Selector de Estados / Regiones (Sin Deslizar: Selector Directo + Atajos Rápidos) -->
            <div class="console-section mb-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-2 gap-2">
                    <span class="console-label">
                        @(RadioState.SelectedCountry == "México" 
                            ? (RadioState.CurrentLanguage == "en" ? "MEXICAN STATES (32 STATES)" : "ESTADOS DE LA REPÚBLICA MEXICANA (32 ESTADOS)") 
                            : RadioState.T("STATE"))
                    </span>

                    <!-- Selector Desplegable Inmediato para los 32 Estados -->
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm console-select-mini" 
                                value="@RadioState.SelectedState" 
                                @onchange="OnStateChanged">
                            <option value="Todos">@RadioState.T("STATE_ALL")</option>
                            @foreach (var stateName in GetAvailableStates())
                            {
                                <option value="@stateName">@stateName</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Pastillas Rápidas de Estados Destacados (Con Enfoque en Oaxaca / Matías Romero) -->
                <div class="states-quick-matrix">
                    <button class="btn-state-pill @(RadioState.SelectedState == "Todos" ? "state-pill-active" : "")"
                            @onclick='() => RadioState.SetStateFilter("Todos")'>
                        <span>📍 @RadioState.T("STATE_ALL")</span>
                    </button>
                    
                    <!-- Acceso Destacado Especial a Oaxaca y Matías Romero -->
                    <button class="btn-state-pill pill-highlight @(RadioState.SelectedState == "Oaxaca" ? "state-pill-active" : "")"
                            @onclick='() => RadioState.SetStateFilter("Oaxaca")'
                            title="Oaxaca: Matías Romero 90.5 FM, Puerto Ángel 650 AM, Valles Centrales, Istmo">
                        <span>🌾 Oaxaca (Matías Romero 90.5 FM)</span>
                    </button>

                    @foreach (var keyState in PopularQuickStates)
                    {
                        var isStateActive = string.Equals(RadioState.SelectedState, keyState, StringComparison.OrdinalIgnoreCase);
                        <button class="btn-state-pill @(isStateActive ? "state-pill-active" : "")"
                                @onclick="() => RadioState.SetStateFilter(keyState)">
                            <span>@keyState</span>
                        </button>
                    }
                </div>
            </div>

            <!-- 3. Selector de Banda (FM / AM / TODAS) + Botón de Explicación Técnica -->
            <div class="console-section mb-3 p-2 band-selector-bar">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="console-label me-1">@RadioState.T("BAND"):</span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-band-opt @(RadioState.SelectedBand == "TODAS" ? "band-opt-active" : "")"
                                    @onclick='() => RadioState.SetBandFilter("TODAS")'>
                                @RadioState.T("BAND_ALL")
                            </button>
                            <button class="btn btn-band-opt @(RadioState.SelectedBand == "FM" ? "band-opt-active" : "")"
                                    @onclick='() => RadioState.SetBandFilter("FM")'>
                                ⚡ FM (88 - 108 MHz)
                            </button>
                            <button class="btn btn-band-opt @(RadioState.SelectedBand == "AM" ? "band-opt-active" : "")"
                                    @onclick='() => RadioState.SetBandFilter("AM")'>
                                📡 AM (540 - 1600 kHz)
                            </button>
                        </div>
                    </div>

                    <!-- Botón para ver Guía Explicativa FM vs AM -->
                    <button class="btn-guide-toggle" @onclick="ToggleFmAmGuide">
                        <span>@RadioState.T("FM_VS_AM_BTN")</span>
                    </button>
                </div>
            </div>

            <!-- Guía Explicativa Interactiva de FM vs AM (Desplegable) -->
            @if (ShowFmAmGuide)
            {
                <div class="fm-am-guide-card p-3 p-md-4 mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="guide-badge">📡 GUÍA DE FRECUENCIAS</span>
                            <h4 class="guide-title mb-0">¿Cuál es la diferencia física entre FM y AM?</h4>
                        </div>
                        <button class="btn-close-guide" @onclick="() => ShowFmAmGuide = false">✕</button>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="guide-box box-fm p-3 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="guide-box-header">⚡ FM (Frecuencia Modulada)</span>
                                    <span class="guide-freq-pill">88.0 – 108.0 MHz</span>
                                </div>
                                <ul class="guide-list mb-0">
                                    <li><b>Calidad de Sonido:</b> Alta fidelidad (Hi-Fi) estéreo cristalino. Ancho de banda de 15 kHz con graves y agudos completos.</li>
                                    <li><b>Inmunidad a Interferencias:</b> Muy resistente a ruidos electromagnéticos (tormentas eléctricas, relámpagos, motores y cables de alta tensión).</li>
                                    <li><b>Alcance de Señal:</b> Línea de visión directa (aprox. 50 a 100 km). Las ondas atraviesan la atmósfera hacia el espacio.</li>
                                    <li><b>Uso Predilecto:</b> Música, juventud, emisoras metropolitanas y sonido inmersivo.</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="guide-box box-am p-3 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="guide-box-header">📡 AM (Amplitud Modulada)</span>
                                    <span class="guide-freq-pill">540 – 1600 kHz</span>
                                </div>
                                <ul class="guide-list mb-0">
                                    <li><b>Calidad de Sonido:</b> Señal monoaural con ancho de banda menor (hasta 5 kHz), óptimo para la voz humana.</li>
                                    <li><b>Sensibilidad al Entorno:</b> Sensible a descargas estáticas, tormentas y ruidos de aparatos eléctricos.</li>
                                    <li><b>Alcance Masivo:</b> Enorme cobertura de cientos o miles de kilómetros. Por la noche, las ondas rebotan en la <i>ionósfera</i> (onda celeste), superando montañas y curvaturas de la Tierra.</li>
                                    <li><b>Uso Predilecto:</b> Noticias, opinión, deportes, zonas rurales, sierras y costas apartadas (como la 650 AM en Puerto Ángel).</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- 4. Fila: Ciudad, Escáner de Búsqueda y Limpiar -->
            <div class="row g-2 align-items-end mb-3">
                <div class="col-12 col-md-4 col-xl-3">
                    <label class="console-label mb-1">@RadioState.T("CITY")</label>
                    <select class="form-select console-select" 
                            value="@RadioState.SelectedCity" 
                            @onchange="OnCityChanged">
                        <option value="Todas">@RadioState.T("CITY_ALL")</option>
                        @foreach (var city in GetAvailableCities())
                        {
                            <option value="@city">@city</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-7">
                    <label class="console-label mb-1">@RadioState.T("SEARCH_LABEL")</label>
                    <div class="console-search-box">
                        <span class="search-radio-icon">📻</span>
                        <input type="text" 
                               class="console-search-input" 
                               placeholder="@RadioState.T("SEARCH_PLACEHOLDER")" 
                               value="@RadioState.SearchQuery" 
                               @oninput="OnSearchInput" />
                        @if (!string.IsNullOrWhiteSpace(RadioState.SearchQuery))
                        {
                            <button class="btn-clear-search" @onclick='() => RadioState.SetSearchQuery(string.Empty)'>✕</button>
                        }
                    </div>
                </div>

                <div class="col-12 col-md-2 col-xl-2">
                    <button class="btn-console-reset w-100" 
                            @onclick="RadioState.ResetFilters" 
                            title="Restablecer todos los filtros">
                        @RadioState.T("RESET")
                    </button>
                </div>
            </div>

            <!-- 5. Conmutadores de Géneros Musicales -->
            <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top-console">
                <span class="console-label me-1">@RadioState.T("GENRE"):</span>
                <button class="btn-genre-switch @(RadioState.SelectedGenre == "Todos" ? "genre-switch-active" : "")" 
                        @onclick='() => RadioState.SetGenreFilter("Todos")'>
                    @RadioState.T("GENRE_ALL")
                </button>
                <button class="btn-genre-switch @(RadioState.SelectedGenre.Contains("Banda") || RadioState.SelectedGenre.Contains("Regional") ? "genre-switch-active" : "")" 
                        @onclick='() => RadioState.SetGenreFilter("Regional")'>
                    🇲🇽 Regional & Banda
                </button>
                <button class="btn-genre-switch @(RadioState.SelectedGenre.Contains("Rock") ? "genre-switch-active" : "")" 
                        @onclick='() => RadioState.SetGenreFilter("Rock")'>
                    🎸 Rock
                </button>
                <button class="btn-genre-switch @(RadioState.SelectedGenre.Contains("Noticias") ? "genre-switch-active" : "")" 
                        @onclick='() => RadioState.SetGenreFilter("Noticias")'>
                    📰 Noticias & Opinión
                </button>
                <button class="btn-genre-switch @(RadioState.SelectedGenre.Contains("Cumbia") || RadioState.SelectedGenre.Contains("Salsa") ? "genre-switch-active" : "")" 
                        @onclick='() => RadioState.SetGenreFilter("Salsa")'>
                    💃 Cumbia & Salsa
                </button>
                <button class="btn-genre-switch @(RadioState.SelectedGenre.Contains("Pop") ? "genre-switch-active" : "")" 
                        @onclick='() => RadioState.SetGenreFilter("Pop")'>
                    🎧 Pop & Hits
                </button>
                <button class="btn-genre-switch @(RadioState.SelectedGenre.Contains("Jazz") ? "genre-switch-active" : "")" 
                        @onclick='() => RadioState.SetGenreFilter("Jazz")'>
                    🎷 Jazz
                </button>
                <button class="btn-genre-switch @(RadioState.SelectedGenre.Contains("Clásica") ? "genre-switch-active" : "")" 
                        @onclick='() => RadioState.SetGenreFilter("Clásica")'>
                    🎻 Clásica
                </button>
            </div>
        </section>
    };

    private RenderFragment RenderStationsGrid() => __builder =>
    {
        @if (RadioState.FilteredStations.Count == 0)
        {
            <div class="empty-stations-deck text-center py-5 my-3 p-4">
                <div class="empty-icon mb-2">📻</div>
                <h4 class="fw-bold text-cream mb-1">@RadioState.T("EMPTY_TITLE")</h4>
                <p class="text-secondary small mb-3">
                    @RadioState.T("EMPTY_DESC")
                </p>
                <button class="btn-tune-retro px-4 py-2" @onclick="RadioState.ResetFilters">
                    @RadioState.T("EMPTY_BTN")
                </button>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-2 row-cols-xxl-3 g-3 mb-5">
                @foreach (var station in RadioState.FilteredStations)
                {
                    var isCurrent = RadioState.ActiveStation?.Id == station.Id;
                    var isPlayingThis = isCurrent && RadioState.IsPlaying;
                    var isFavorite = RadioState.FavoriteStationIds.Contains(station.Id);
                    var isAm = station.Band.Equals("AM", StringComparison.OrdinalIgnoreCase) || station.Frequency > 150;

                    <div class="col">
                        <div class="retro-station-card h-100 @(isCurrent ? "card-station-active" : "")">
                            <div class="card-station-header">
                                <div class="station-thumb-wrapper @(isPlayingThis ? "thumb-spinning" : "")">
                                    <img src="@station.LogoUrl" alt="@station.Name" class="station-thumb-img" loading="lazy" />
                                    @if (isPlayingThis)
                                    {
                                        <div class="thumb-equalizer-overlay">
                                            <div class="eq-bar"></div>
                                            <div class="eq-bar"></div>
                                            <div class="eq-bar"></div>
                                        </div>
                                    }
                                </div>

                                <div class="station-header-text">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="frequency-badge @(isAm ? "badge-am" : "badge-fm")">
                                            @station.Frequency.ToString(isAm ? "F0" : "F1") @station.Band
                                        </span>
                                        <button class="btn-favorite @(isFavorite ? "favorite-active" : "")" 
                                                @onclick="() => RadioState.ToggleFavoriteAsync(station.Id)"
                                                title="@(isFavorite ? "Quitar de favoritas" : "Guardar en favoritas")">
                                            ★
                                        </button>
                                    </div>
                                    <h3 class="station-name text-truncate" title="@station.Name">
                                        @station.Name
                                    </h3>
                                    <div class="station-geo-tag text-truncate">
                                        📍 @station.City, @station.State (@station.CountryCode)
                                    </div>
                                </div>
                            </div>

                            <div class="card-station-body">
                                <p class="station-desc">
                                    @station.Description
                                </p>
                            </div>

                            <div class="card-station-footer">
                                <span class="genre-tag text-truncate">
                                    @station.Genre
                                </span>

                                <button class="btn-tune-retro @(isPlayingThis ? "btn-tune-playing" : "")" 
                                        @onclick="() => HandleTuneClick(station)">
                                    @(isPlayingThis ? "⏸ " + RadioState.T("PAUSE") : (isCurrent ? "▶ " + RadioState.T("PLAYING") : "▶ " + RadioState.T("TUNE")))
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    };
}

@code {
    private bool IsSideBySide { get; set; } = true;
    private bool ShowFmAmGuide { get; set; } = false;

    private record CountryItem(string Name, string Flag);

    private readonly List<CountryItem> TopCountries =
    [
        new("Todos", "🌐"),
        new("México", "🇲🇽"),
        new("Colombia", "🇨🇴"),
        new("España", "🇪🇸"),
        new("Argentina", "🇦🇷"),
        new("Estados Unidos", "🇺🇸"),
        new("Reino Unido", "🇬🇧"),
        new("Francia", "🇫🇷"),
        new("Alemania", "🇩🇪"),
        new("Italia", "🇮🇹"),
        new("Canadá", "🇨🇦"),
        new("Japón", "🇯🇵"),
        new("Chile", "🇨🇱"),
        new("Perú", "🇵🇪"),
        new("Brasil", "🇧🇷"),
        new("Suiza", "🇨🇭"),
        new("Uruguay", "🇺🇾"),
        new("Costa Rica", "🇨🇷")
    ];

    private readonly List<string> PopularQuickStates =
    [
        "Ciudad de México",
        "Jalisco",
        "Nuevo León",
        "Chiapas",
        "Veracruz",
        "Puebla",
        "Sonora",
        "Chihuahua",
        "Quintana Roo",
        "Estado de México",
        "Guanajuato"
    ];

    protected override void OnInitialized()
    {
        RadioState.OnStateChanged += HandleStateChanged;
    }

    private void ToggleLayoutMode()
    {
        IsSideBySide = !IsSideBySide;
    }

    private void ToggleFmAmGuide()
    {
        ShowFmAmGuide = !ShowFmAmGuide;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private IEnumerable<string> GetAvailableStates()
    {
        if (RadioState.SelectedCountry == "México" || RadioState.SelectedCountry == "Todos")
        {
            if (RadioState.FilterOptions.States is not null && RadioState.FilterOptions.States.Count > 0)
            {
                return RadioState.FilterOptions.States;
            }
        }

        var states = RadioState.AllStations
            .Where(s => RadioState.SelectedCountry == "Todos" || string.Equals(RadioStateService.NormalizeText(s.Country), RadioStateService.NormalizeText(RadioState.SelectedCountry), StringComparison.OrdinalIgnoreCase))
            .Select(s => s.State)
            .Where(st => !string.IsNullOrEmpty(st) && st != "Nacional")
            .Distinct()
            .OrderBy(st => st)
            .ToList();

        return states.Count > 0 ? states : ["Chiapas", "Ciudad de México", "Jalisco", "Nuevo León", "Oaxaca", "Puebla", "Veracruz"];
    }

    private IEnumerable<string> GetAvailableCities()
    {
        var normCountry = RadioStateService.NormalizeText(RadioState.SelectedCountry);
        var normState = RadioStateService.NormalizeText(RadioState.SelectedState);

        var q = RadioState.AllStations.AsEnumerable();
        if (normCountry != "todos" && !string.IsNullOrEmpty(normCountry))
        {
            q = q.Where(s => RadioStateService.NormalizeText(s.Country) == normCountry || RadioStateService.NormalizeText(s.Country).Contains(normCountry));
        }
        if (normState != "todos" && !string.IsNullOrEmpty(normState))
        {
            q = q.Where(s => RadioStateService.NormalizeText(s.State) == normState || RadioStateService.NormalizeText(s.State).Contains(normState));
        }
        return q.Select(s => s.City).Where(c => !string.IsNullOrEmpty(c) && c != "Nacional").Distinct().OrderBy(c => c);
    }

    private void OnCountryChanged(ChangeEventArgs e)
    {
        RadioState.SetCountryFilter(e.Value?.ToString() ?? "Todos");
    }

    private void OnStateChanged(ChangeEventArgs e)
    {
        RadioState.SetStateFilter(e.Value?.ToString() ?? "Todos");
    }

    private void OnCityChanged(ChangeEventArgs e)
    {
        RadioState.SetCityFilter(e.Value?.ToString() ?? "Todas");
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        RadioState.SetSearchQuery(e.Value?.ToString() ?? string.Empty);
    }

    private async Task HandleTuneClick(Station station)
    {
        if (RadioState.ActiveStation?.Id == station.Id && RadioState.IsPlaying)
        {
            await RadioState.TogglePlayAsync();
        }
        else
        {
            await RadioState.TuneStationAsync(station);
        }
    }

    public void Dispose()
    {
        RadioState.OnStateChanged -= HandleStateChanged;
    }
}
