@using frontend.Services
@inject RadioStateService RadioState
@implements IDisposable

<div class="radio-player-bar">
    <div class="radio-player-container">
        <!-- 1. Sección Información de Pista (Metadata y Emisora) -->
        <div class="track-info-section">
            <div class="album-art-wrapper @(RadioState.IsPlaying ? "spinning" : "")">
                <img src="@(string.IsNullOrEmpty(RadioState.ActiveStation?.LogoUrl) ? (RadioState.CurrentTrack.CoverUrl ?? "favicon.png") : RadioState.ActiveStation.LogoUrl)" 
                     alt="Emisora" 
                     class="album-art" />
                <div class="art-center-hole"></div>
            </div>

            <div class="track-details">
                <div class="live-badge-row">
                    <span class="badge-live">
                        <span class="pulsing-dot"></span> EN VIVO
                    </span>
                    @if (RadioState.ActiveStation is not null)
                    {
                        <span class="badge-station-location">
                            @RadioState.ActiveStation.CountryCode · @RadioState.ActiveStation.City
                        </span>
                    }
                    <span class="listeners-badge" title="Oyentes sintonizados simultáneamente">
                        <svg class="icon-users" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        <span>@RadioState.ListenersCount</span>
                    </span>
                </div>
                <div class="track-title-row">
                    <div class="track-title" title="@(RadioState.ActiveStation?.Name ?? RadioState.CurrentTrack.Title)">
                        @(RadioState.ActiveStation?.Name ?? RadioState.CurrentTrack.Title)
                    </div>
                    @if (RadioState.IsPlaying)
                    {
                        <div class="player-wave-bars" title="Transmitiendo audio en directo">
                            <span></span><span></span><span></span><span></span>
                        </div>
                    }
                </div>
                <div class="track-artist" title="@(RadioState.ActiveStation?.Genre ?? RadioState.CurrentTrack.Artist)">
                    <span class="text-genre">@(RadioState.ActiveStation?.Genre)</span>
                    @if (!string.IsNullOrEmpty(RadioState.ActiveStation?.Locality))
                    {
                        <span class="text-locality"> · @RadioState.ActiveStation.Locality</span>
                    }
                </div>
            </div>
        </div>

        <!-- 2. Sección Controles Centrales de Reproducción -->
        <div class="controls-section">
            <button class="btn-player-skip" @onclick="RadioState.TunePreviousStationAsync" title="Emisora Anterior" aria-label="Anterior">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
                    <polygon points="19 20 9 12 19 4 19 20"></polygon>
                    <line x1="5" y1="19" x2="5" y2="5" stroke="currentColor" stroke-width="2.5"></line>
                </svg>
            </button>
            <button class="btn-play-pause @(RadioState.IsPlaying ? "playing" : "")" 
                    @onclick="RadioState.TogglePlayAsync"
                    aria-label="@(RadioState.IsPlaying ? "Pausar" : "Reproducir")">
                @if (RadioState.IsPlaying)
                {
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                        <rect x="6" y="4" width="4" height="16" rx="1.5"></rect>
                        <rect x="14" y="4" width="4" height="16" rx="1.5"></rect>
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" style="margin-left: 2px;">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                }
            </button>
            <button class="btn-player-skip" @onclick="RadioState.TuneNextStationAsync" title="Siguiente Emisora" aria-label="Siguiente">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
                    <polygon points="5 4 15 12 5 20 5 4"></polygon>
                    <line x1="19" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="2.5"></line>
                </svg>
            </button>
        </div>

        <!-- 3. Sección Volumen y Estado de Conexión -->
        <div class="extras-section">
            <div class="volume-container">
                <button class="btn-volume-icon" @onclick="RadioState.ToggleMuteAsync" aria-label="Silenciar">
                    @if (RadioState.IsMuted || RadioState.Volume == 0)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                            <line x1="23" y1="9" x2="17" y2="15"></line>
                            <line x1="17" y1="9" x2="23" y2="15"></line>
                        </svg>
                    }
                    else if (RadioState.Volume < 0.5)
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                        </svg>
                    }
                </button>
                <input type="range" 
                       min="0" 
                       max="1" 
                       step="0.01" 
                       class="volume-slider"
                       value="@(RadioState.IsMuted ? 0 : RadioState.Volume)"
                       @oninput="HandleVolumeChange" />
            </div>

            <div class="status-indicator" title="@RadioState.ConnectionStatusText">
                <span class="status-dot @(RadioState.IsConnected ? "dot-online" : "dot-reconnecting")"></span>
                <span class="status-label">@(RadioState.IsConnected ? "En línea" : "Reconectando...")</span>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        RadioState.OnStateChanged += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RadioState.InitializeAsync();
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleVolumeChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var vol))
        {
            await RadioState.SetVolumeAsync(vol);
        }
    }

    public void Dispose()
    {
        RadioState.OnStateChanged -= HandleStateChanged;
    }
}
